# ── LLM ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here

# ── Harvey HPC ───────────────────────────────────────
HARVEY_HOST=harvey.your-institution.edu
HARVEY_USER=your_username
HARVEY_KEY_PATH=~/.ssh/id_rsa
HARVEY_CASES_DIR=/scratch/your_username/plaque_cases
HARVEY_PARTITION=normal          # SLURM partition name
HARVEY_ACCOUNT=your_account      # SLURM account (if required)

# ── Workstations ─────────────────────────────────────
WK1_HOST=wk1.local
WK1_USER=jeff
WK2_HOST=wk2.local
WK2_USER=jeff
WK_KEY_PATH=~/.ssh/id_rsa

# ── Local Paths ───────────────────────────────────────
CASES_DIR=/path/to/local/cases
DATA_DIR=/path/to/local/data
RESULTS_DIR=/path/to/local/results

# ── Pipeline Settings ─────────────────────────────────
N_CASES=1000
MOCK_MODE=false                  # true = no real HPC calls
MAX_MESH_RETRIES=3
MAX_SOLVER_RETRIES=2
HPC_POLL_INTERVAL=60             # seconds between squeue polls
